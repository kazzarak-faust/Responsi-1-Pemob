<?xml version="1.0" encoding="utf-8"?>
    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

        <uses-permission android:name="android.permission.INTERNET" />

        <application
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@drawable/ic_nantes_logo"
            android:label="Responsi app"
            android:roundIcon="@drawable/ic_nantes_logo"
            android:supportsRtl="true"
            android:usesCleartextTraffic="true"
            android:theme="@style/Theme.Responsi1MobileH1D023113"
            tools:targetApi="34">

            <!-- Activity utama -->
            <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="Responsi"
                android:theme="@style/Theme.Responsi1MobileH1D023113">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>
            <activity android:name=".ProfileActivity" />
            <activity android:name=".CoachActivity" />
            <activity android:name=".PlayersActivity" />

        </application>
    </manifest>
